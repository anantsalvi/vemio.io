# ============================================================================
# VEMIO™ Dashboard — Environment Variables
# Copy to .env.local for local development
# Set in Vercel dashboard for production
# ============================================================================

# ── Database ────────────────────────────────────────────────────────────────
# PgBouncer on your DigitalOcean VPS (transaction mode)
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://vemio_api:YOUR_PASSWORD@159.203.124.36:6432/vemio_db

# Set to "true" if using SSL connection (recommended for production)
DATABASE_SSL=false

# ── NextAuth.js ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_A_RANDOM_STRING

# Production URL (no trailing slash)
NEXTAUTH_URL=https://www.vemio.in

# ── Auvik Webhook ───────────────────────────────────────────────────────────
# HMAC-SHA256 secret for webhook signature validation
# Set this in Auvik's webhook configuration AND here (must match)
# Generate with: openssl rand -hex 32
AUVIK_WEBHOOK_SECRET=CHANGE_ME_GENERATE_A_HEX_STRING

# ── Auvik REST API (for future Phase 2 reconciliation worker) ───────────────
# AUVIK_API_BASE=https://auvikapi.us6.my.auvik.com/v1
# AUVIK_USERNAME=your-auvik-username
# AUVIK_API_KEY=your-auvik-api-key
